# Set to "true" to test the UI with local mock data before connecting Google Sheets
VITE_USE_MOCK=true

# Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
VITE_API_URL=

# Shared secret configured in Apps Script Properties (API_TOKEN)
# Leave blank for public GitHub Pages builds and enter it in the in-app Settings modal
VITE_API_TOKEN=
